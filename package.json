{
  "name": "@codebygarv/express-lens",
  "version": "2.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight, plug-and-play monitoring package for Express.js applications.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test"
  },
  "keywords": [
    "express",
    "express-middleware",
    "morgan",
    "morgan-alternative",
    "logger",
    "logging",
    "express-logging",
    "monitor",
    "monitoring",
    "metrics",
    "apm",
    "observability",
    "performance",
    "memory-monitoring",
    "route-metrics",
    "realtime-analytics"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
